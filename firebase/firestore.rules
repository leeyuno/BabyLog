// BabyLog 가족 공유 Firestore 보안 규칙 (iOS · Android 공용)
//
// 구조
//   families/{familyId}               { members: [uid...], createdBy, createdAt, joinCode? }
//   families/{familyId}/babies/{id}   아기 프로필
//   families/{familyId}/events/{id}   기록 (updatedAt, deleted 로 동기화)
//   families/{familyId}/weights/{id}  몸무게 기록
//   invites/{code}                    { familyId, createdBy, expiresAt }  6자리 초대 코드, 24시간 유효
//
// 원칙
//   - 가족 구성원(members 에 uid 가 있는 사람)만 그 가족의 데이터를 읽고 쓴다
//   - 가족에 들어오는 유일한 방법: 유효한 초대 코드로 "자기 uid 하나만" members 끝에 추가
//   - 초대 코드는 코드를 아는 사람만 단건 조회 가능 (목록 조회 금지)
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function family(fid) { return get(/databases/$(db)/documents/families/$(fid)); }
    function isMember(fid) { return signedIn() && request.auth.uid in family(fid).data.members; }

    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(fid) || validJoin(fid);
      allow delete: if false;

      function validJoin(fid) {
        let invite = get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode));
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && invite.data.familyId == fid
          && invite.data.expiresAt > request.time;
      }

      match /{collection}/{docId} {
        allow read, write: if isMember(fid);
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isMember(request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && isMember(resource.data.familyId);
      allow update: if false;
    }
  }
}
