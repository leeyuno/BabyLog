# *.xcworkspace

# ========== Swift Package Manager ==========
.swiftpm/
.build/
# Package.resolved는 추적 권장
!Package.resolved

# ========== CocoaPods ==========
/Pods/
!Podfile
!Podfile.lock

# ========== Carthage (사용 안 하면 무시해도 OK) ==========
Carthage/

# ========== Fastlane(사용 시) ==========
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# ========== Logs / Temps ==========
*.log
*.tmp
*.swp

# ========== Playgrounds ==========
timeline.xctimeline
playground.xcworkspace

# ========== Local Configs / Secrets (필요 시) ==========
*.xcconfig.local
.env


# ========== Firebase (가족 공유) ==========
# 공개 저장소이므로 앱 설정 파일은 커밋하지 않는다. 빌드 스크립트가 파일이 있을 때만 앱에 복사한다.
# 받는 법: firebase apps:sdkconfig IOS --project babylog-leeyuno -o BabyLog/GoogleService-Info.plist
BabyLog/GoogleService-Info.plist
firebase-debug.log
firebase/.firebase/
